// ============================================================================
// PRISMA SCHEMA CONFIGURATION
// ============================================================================
// This schema defines the complete data model for MaltTalk, an online language
// learning platform. The schema supports multiple content types (video, reading,
// flashcards, drag-drop) associated with lessons organized by topics and courses.
// Database: PostgreSQL with UUID generation for lessons.
// ============================================================================

// Prisma Client Generator - Outputs to src/generated/prisma (for app development)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma Client Generator - Default output for seed script compatibility
generator client_default {
  provider = "prisma-client"
  output   = "../.prisma/client"
}

// PostgreSQL datasource configuration
datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUM: Lesson Type
// ============================================================================
/// Defines the eight content types available for language learning lessons.
enum lesson_type {
  video              // Video content with duration tracking
  flashcards         // Spaced repetition flashcard system
  drag_drop          @map("drag-drop") // Drag and drop interactive exercises
  reading            // Reading comprehension with glossary support
  visio_acoustic     @map("visio-acoustic") // Visio-acoustic diagnostic quiz system
  writing_challenges @map("writing-challenges") // Writing expression challenges with vocabulary validation
  mental_agility     @map("mental-agility") // Timed mental agility challenges
  closing_exam       @map("closing-exam") // Unit closing assessment tests
}

// ============================================================================
// MODEL: courses
// ============================================================================
/// Represents a language course (e.g., "English", "Spanish").
/// Primary key is the course slug for URL-friendly identifiers.
/// Topics are organized within courses for curriculum structure.
model courses {
  slug        String   @id @db.VarChar(255) // URL-friendly identifier (e.g., "english")
  id          Int      @default(autoincrement()) // Auto-increment ID for internal use
  title       String   @db.VarChar(255) // Display name of the course
  description String?  // Detailed course description
  topics      topics[] // One-to-many relationship with topics
}

// ============================================================================
// MODEL: topics
// ============================================================================
/// Represents a learning module within a course (e.g., "Greetings", "Numbers").
/// Topics contain lessons and organize curriculum hierarchically.
model topics {
  id          Int       @id @default(autoincrement()) // Primary key
  slug        String    @unique @db.VarChar(255) // URL-friendly identifier
  title       String    @db.VarChar(255) // Display name
  course_slug String    @db.VarChar(255) // Foreign key to courses
  lessons     lessons[] // One-to-many relationship with lessons
  courses     courses   @relation(fields: [course_slug], references: [slug], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
}

// ============================================================================
// MODEL: lessons
// ============================================================================
/// Represents individual learning units. Each lesson has a type (video, 
/// flashcards, drag_drop, reading) and associated content in related tables.
/// The UUID field enables public lesson sharing via URL.
model lessons {
  id                 Int                  @id @default(autoincrement()) // Primary key
  uuid               String?              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Public identifier for sharing
  topic_id           Int                  // Foreign key to topics
  type               lesson_type          // Content type of this lesson
  title              String               @db.VarChar(255) // Lesson display name
  description        String?              @db.Text // Detailed lesson description
  slug               String?              @db.VarChar(255) // URL-friendly identifier
  
  // Foreign key relationships
  topics             topics               @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topic")
  
  // Content relationships (one lesson has many content items based on type)
  video_contents     video_contents[]
  reading_contents   reading_contents[]
  flashcard_contents flashcard_contents[]
  drag_drop_contents drag_drop_contents[]
  visio_acoustic_contents visio_acoustic_contents[]
  writing_challenge_contents writing_challenge_contents[]
  mental_agility_contents mental_agility_contents[]
  closing_exam_contents closing_exam_contents[]
  
  // Tag relationship
  lesson_tag         lesson_tag[]
}

// ============================================================================
// MODEL: video_contents
// ============================================================================
/// Stores video lesson content with metadata.
/// Duration is tracked in seconds with a default of 600s (10 minutes).
model video_contents {
  id          Int     @id @default(autoincrement()) // Primary key
  lesson_id   Int     // Foreign key to lessons
  url         String  @db.VarChar(255) // Video URL (external service or local)
  description String? // Optional video description or transcript
  duration    Int?    @default(600) // Duration in seconds (default: 10 minutes)
  
  // Foreign key relationship
  lessons     lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_video")
}

// ============================================================================
// MODEL: reading_contents
// ============================================================================
/// Stores reading comprehension lesson content with text and associated glossary.
model reading_contents {
  id             Int               @id @default(autoincrement()) // Primary key
  lesson_id      Int               // Foreign key to lessons
  text           String            @db.Text // Full reading content
  
  // Foreign key relationship
  lessons        lessons           @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_reading")
  
  // Glossary items for vocabulary support
  glossary_items glossary_items[]
}

// ============================================================================
// MODEL: glossary_items
// ============================================================================
/// Dictionary entries for reading content, providing word definitions,
/// translations, images, and synonyms for vocabulary learning.
model glossary_items {
  id              Int               @id @default(autoincrement()) // Primary key
  reading_id      Int               // Foreign key to reading_contents
  word            String            @db.VarChar(255) // Target word or phrase
  definition      String            @db.Text // Word definition in learning language
  image_url       String?           @db.VarChar(255) // Optional visual reference
  synonym_english String?           @db.VarChar(255) // English equivalent for translation
  
  // Foreign key relationship
  reading_contents reading_contents  @relation(fields: [reading_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_glossary")
}

// ============================================================================
// MODEL: flashcard_contents
// ============================================================================
/// Implements spaced repetition flashcard system for vocabulary learning.
/// Front can display an image, back displays text with pronunciation.
model flashcard_contents {
  id                 Int     @id @default(autoincrement()) // Primary key
  lesson_id          Int     // Foreign key to lessons
  front_image        String? @db.VarChar(255) // Optional image for card front
  back_title         String  @db.VarChar(255) // Main word/phrase on card back
  back_pronunciation String? @db.VarChar(255) // Phonetic pronunciation guide
  lang               String  @db.VarChar(10) // Language code (e.g., "en", "es")
  
  // Foreign key relationship
  lessons            lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_flashcard")
}

// ============================================================================
// MODEL: drag_drop_contents
// ============================================================================
/// Interactive drag-and-drop exercise content for grammar and syntax practice.
/// Supports categorized items with custom feedback for incorrect answers.
model drag_drop_contents {
  id                     Int     @id @default(autoincrement()) // Primary key
  lesson_id              Int     // Foreign key to lessons
  text                   String  @db.VarChar(255) // Item text to be dragged
  category               String  @db.VarChar(255) // Target category for correct placement
  feedback_message_wrong String? // Custom feedback message for incorrect placements
  
  // Foreign key relationship
  lessons                lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_drag_drop")
}

// ============================================================================
// MODEL: tags
// ============================================================================
/// Vocabulary tags for lesson categorization and search.
/// Tags are linked to lessons via the lesson_tag junction table.
model tags {
  id         Int          @id @default(autoincrement()) // Primary key
  slug       String       @unique @db.VarChar(255) // URL-friendly identifier
  name       String       @db.VarChar(255) // Display name
  lesson_tag lesson_tag[] // Many-to-many relationship with lessons
}

// ============================================================================
// MODEL: lesson_tag (Junction Table)
// ============================================================================
/// Junction table implementing many-to-many relationship between lessons and tags.
/// Uses composite primary key for efficient querying and referential integrity.
model lesson_tag {
  lesson_id Int     // Foreign key to lessons
  tag_id    Int     // Foreign key to tags
  
  // Foreign key relationships
  lessons   lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_tag_lesson")
  tags      tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_tag_tag")

  // Composite primary key ensures one tag per lesson
  @@id([lesson_id, tag_id])
}

// ============================================================================
// MODEL: visio_acoustic_contents
// ============================================================================
/// Implements visio-acoustic diagnostic quiz system for associating sounds
/// with visual elements (gestures, images). Questions test comprehension by
/// matching audio cues with visual representations.
model visio_acoustic_contents {
  id                     Int     @id @default(autoincrement()) // Primary key
  lesson_id              Int     // Foreign key to lessons
  question_text          String  @db.VarChar(255) // Question prompt (e.g., "Choose the gesture for...")
  sound_url              String  @db.VarChar(255) // URL to audio file (sound/pronunciation)
  image_url              String  @db.VarChar(255) // URL to gesture or image for visual reference
  correct_answer         String  @db.VarChar(255) // Text of the correct answer option
  option_b               String  @db.VarChar(255) // Second incorrect answer option
  option_c               String  @db.VarChar(255) // Third incorrect answer option
  option_d               String? @db.VarChar(255) // Fourth optional answer option
  feedback_correct       String? @db.Text // Positive feedback message for correct answer
  feedback_incorrect     String? @db.Text // Feedback message for incorrect answers
  question_order         Int     @default(0) // Order of question within the lesson
  difficulty_level       String  @db.VarChar(50) @default("beginner") // Difficulty: beginner|intermediate|advanced
  
  // Foreign key relationship
  lessons                lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_visio_acoustic")
}

// ============================================================================
// MODEL: writing_challenge_contents
// ============================================================================
/// Stores writing expression challenges where students compose texts using
/// learned vocabulary. Includes prompts, word count requirements, vocabulary
/// validation, difficulty levels, and evaluation criteria.
model writing_challenge_contents {
  id                    Int     @id @default(autoincrement()) // Primary key
  lesson_id             Int     // Foreign key to lessons
  
  /// Challenge title (e.g., "Write a greeting email")
  title                 String  @db.VarChar(255) // Display title of the writing challenge
  
  /// Detailed prompt/instructions for the writing task
  prompt                String  @db.Text // Full prompt text describing the writing task
  
  /// Minimum word count requirement
  min_words             Int     @default(50) // Minimum number of words required
  
  /// Maximum word count limit
  max_words             Int     @default(300) // Maximum number of words allowed
  
  /// Comma-separated list of required vocabulary words to include
  required_vocabulary   String? @db.Text // Comma-separated list of required vocabulary
  
  /// Example answer or model text
  example_answer        String? @db.Text // Model answer for reference
  
  /// Difficulty level: beginner, intermediate, advanced
  difficulty_level      String  @db.VarChar(50) @default("beginner") // Difficulty: beginner|intermediate|advanced
  
  /// Order of challenges within the lesson
  challenge_order       Int     @default(0) // Order of challenge within the lesson
  
  /// Evaluation criteria as JSON (e.g., grammar, vocabulary, structure)
  evaluation_criteria   String? @db.Text // JSON evaluation rubric criteria
  
  /// Hint or guidance for the student
  hint                  String? @db.Text // Optional hint for the student
  
  // Foreign key relationship
  lessons               lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_writing_challenge")
}

// ============================================================================
// MODEL: mental_agility_contents
// ============================================================================
/// Stores timed mental agility challenges for identifying correct terms in sequences.
/// Students race against time to select the correct answer that completes a pattern.
model mental_agility_contents {
  id                    Int     @id @default(autoincrement()) // Primary key
  lesson_id             Int     // Foreign key to lessons
  
  /// Challenge title (e.g., "Complete the sequence")
  title                 String  @db.VarChar(255) // Display title of the challenge
  
  /// Prompt with pattern or sequence
  prompt                String  @db.Text // Full prompt describing the pattern
  
  /// Time limit in seconds
  time_limit            Int     @default(30) // Time limit in seconds (default: 30)
  
  /// Correct answer
  correct_answer        String  @db.VarChar(255) // The correct completion
  
  /// Alternative answer B
  option_b              String  @db.VarChar(255) // Second option
  
  /// Alternative answer C
  option_c              String  @db.VarChar(255) // Third option
  
  /// Optional alternative answer D
  option_d              String? @db.VarChar(255) // Fourth optional option
  
  /// Reference image or visual for the challenge
  image_url             String? @db.VarChar(255) // Optional visual reference
  
  /// Feedback for correct answer
  feedback_correct      String? @db.Text // Positive feedback message
  
  /// Feedback for incorrect answers
  feedback_incorrect    String? @db.Text // Negative feedback message
  
  /// Difficulty level: beginner, intermediate, advanced
  difficulty_level      String  @db.VarChar(50) @default("beginner") // Difficulty level
  
  /// Order of challenges within the lesson
  challenge_order       Int     @default(0) // Order of challenge within the lesson
  
  /// Category/type of mental challenge
  challenge_type        String? @db.VarChar(100) // e.g., "sequence", "pattern", "word_association"
  
  // Foreign key relationship
  lessons               lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_mental_agility")
}

// ============================================================================
// MODEL: closing_exam_contents
// ============================================================================
/// Stores timed unit closing assessment tests to measure overall comprehension.
/// Tests are chronometer-based evaluations given at the end of learning units.
model closing_exam_contents {
  id                    Int     @id @default(autoincrement()) // Primary key
  lesson_id             Int     // Foreign key to lessons
  
  /// Exam title
  title                 String  @db.VarChar(255) // Display title of the exam
  
  /// Exam description
  description           String? @db.Text // Details about what the exam covers
  
  /// Time limit in seconds for entire exam
  time_limit            Int     @default(600) // Time limit in seconds (default: 10 min)
  
  /// Question or prompt
  question              String  @db.Text // Question or task prompt
  
  /// Correct answer option
  correct_answer        String  @db.VarChar(255) // The correct answer
  
  /// Alternative answer B
  option_b              String  @db.VarChar(255) // Second option
  
  /// Alternative answer C
  option_c              String  @db.VarChar(255) // Third option
  
  /// Optional alternative answer D
  option_d              String? @db.VarChar(255) // Fourth optional option
  
  /// Passing score percentage
  passing_score         Int     @default(70) // Minimum percentage to pass (0-100)
  
  /// Difficulty level: beginner, intermediate, advanced
  difficulty_level      String  @db.VarChar(50) @default("beginner") // Difficulty level
  
  /// Question order in exam
  question_order        Int     @default(0) // Order of question within the exam
  
  /// Points value for this question
  points_value          Int     @default(1) // Points awarded for correct answer
  
  /// Feedback for correct answer
  feedback_correct      String? @db.Text // Positive feedback message
  
  /// Feedback for incorrect answers
  feedback_incorrect    String? @db.Text // Negative feedback message
  
  // Foreign key relationship
  lessons               lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_closing_exam")
}
